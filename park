<!DOCTYPE html>
<html lang="et">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Parkimisloa kontroll</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f3f3;
      margin: 0;
      padding: 25px;
      text-align: center;
    }

    .card {
      max-width: 420px;
      margin: 30px auto;
      background: white;
      padding: 35px;
      border-radius: 16px;
      box-shadow: 0 3px 15px rgba(0,0,0,.08);
    }

    .reg {
      font-size: 38px;
      font-weight: bold;
      margin: 20px 0;
    }

    .status {
      font-size: 30px;
      font-weight: bold;
      margin: 25px 0;
    }

    .valid {
      color: #159447;
    }

    .invalid {
      color: #d32f2f;
    }

    .label {
      color: #777;
      font-size: 14px;
    }
  </style>
</head>

<body>

<div class="card" id="result">
  Kontrollin parkimisluba...
</div>

<script>

const CSV_URL =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vQJ2FJlBILmtLsYYJ4SgZ3jzEydJCWFWBSK_jMuBFRmY_h2z8YeQJtkbSVyX8NT23SgQOnsKRCB8D57/pub?gid=0&single=true&output=csv";

const params = new URLSearchParams(window.location.search);

const id = params.get("id");


fetch(CSV_URL)
  .then(response => response.text())
  .then(csv => {

    const rows = csv.trim().split("\n");

    const permit = rows
      .slice(1)
      .map(row => row.split(","))
      .find(row => row[0].trim() === id);

    if (!permit) {

      document.getElementById("result").innerHTML = `
        <div class="status invalid">
          LUBA EI LEITUD
        </div>

        <div>
          ${id || ""}
        </div>
      `;

      return;
    }


    const permitId = permit[0].trim();
    const reg = permit[1].trim();
    const from = permit[2].trim();
    const until = permit[3].trim();
    const status = permit[4].trim();


    const active =
      status.toLowerCase() === "aktiivne";


    document.getElementById("result").innerHTML = `

      <div class="label">
        PARKIMISLUBA
      </div>

      <div class="reg">
        ${reg}
      </div>

      <div class="status ${active ? "valid" : "invalid"}">
        ${active ? "KEHTIV" : "EI KEHTI"}
      </div>

      <div>
        <strong>Loa nr:</strong>
        ${permitId}
      </div>

      <br>

      <div>
        <strong>Kehtib:</strong><br>
        ${from} – ${until}
      </div>

    `;

  })

  .catch(error => {

    document.getElementById("result").innerHTML = `
      <div class="status invalid">
        Andmete laadimine ebaõnnestus
      </div>
    `;

  });

</script>

</body>
</html>
